# ==========================================
# Root .gitignore for Shop-Project
# Covers frontend (Next.js) & backend (Node/Express/MongoDB)
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# Environment variables & secrets (keep examples committed)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local
!**/.env.example

# Certificates and keys
*.pem
*.key
*.cert

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & coverage
coverage/
**/coverage/
.nyc_output/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Deployment & cloud
.vercel/

# Uploaded files & temporary storage
uploads/
**/uploads/
tmp/
temp/
stitch_assets/


# Database dumps / local DB
*.sqlite
*.db

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
