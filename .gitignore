# ==========================================
# Root .gitignore for Shop-Project
# Covers Frontend (Next.js), Backend (Node/Express/MongoDB), and Deployment
# ==========================================

# ── Dependencies ──
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ── Build & Distribution Outputs ──
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/

# ── Environment Variables & Secrets ──
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# ── SSL Certificates & Secret Keys ──
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ── Logs & Debugging ──
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ── Testing & Code Coverage ──
coverage/
**/coverage/
.nyc_output/

# ── TypeScript Cache & Declarations ──
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# ── Deployment & Cloud Providers ──
.vercel/
**/.vercel/

# ── Uploads, Media & Temporary Storage ──
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/
stitch_assets/
**/stitch_assets/

# ── Database Dumps & Local DBs ──
*.sqlite
*.sqlite3
*.db
*.db-journal

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
**/Thumbs.db
**/ehthumbs.db
[Dd]esktop.ini
**/[Dd]esktop.ini
*.tmp

# ── IDEs, Editors & AI Workspaces ──
.idea/
**/.idea/
.vscode/
**/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
.gemini/
**/.gemini/
.agents/
**/.agents/
.claude/
**/.claude/
.cursor/
**/.cursor/
